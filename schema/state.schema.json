{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Low-Energy-Guard Local-First Backup Schema",
  "description": "Local health & pacing archive exported by Low-Energy-Guard (sleep, spoons, emotion/rumination logs, micro-tasks).",
  "type": "object",
  "properties": {
    "lang": { "type": "string", "enum": ["zh", "en"] },
    "theme": { "type": "string", "enum": ["warm-dark", "warm-paper"] },
    "spoons": { "type": "integer", "minimum": 1, "maximum": 12 },
    "sleep": {
      "type": "object",
      "properties": {
        "bedTime": { "type": "string" },
        "wakeTime": { "type": "string" },
        "quality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "napMinutes": { "type": "integer", "minimum": 0 },
        "targetHours": { "type": "number" },
        "note": { "type": "string" }
      }
    },
    "sleepHistory": { "type": "array" },
    "mood": { "type": "string" },
    "ruminationFlags": { "type": "array", "items": { "type": "string" } },
    "emotionLogs": { "type": "array" },
    "tasks": { "type": "array" }
  }
}
