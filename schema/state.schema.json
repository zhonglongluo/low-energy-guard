{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spoon Planner Local-First Backup Schema",
  "type": "object",
  "properties": {
    "lang": { "type": "string", "enum": ["zh", "en"] },
    "theme": { "type": "string", "enum": ["warm-dark", "warm-paper"] },
    "spoons": { "type": "integer", "minimum": 1, "maximum": 12 },
    "adaptiveFilter": { "type": "boolean" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "cost", "done"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "cost": { "type": "integer", "minimum": 1, "maximum": 4 },
          "tag": { "type": "string" },
          "done": { "type": "boolean" },
          "steps": { "type": "array" }
        }
      }
    },
    "brainDump": { "type": "array" },
    "history": { "type": "array" }
  }
}
